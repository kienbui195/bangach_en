# Kết nối MySQL: DATABASE_URL, hoặc bộ DATABASE_* (do `vps db-create hub` ghi ở /srv/secrets/hub.db.env)
DATABASE_URL=mysql://hub:doi-mat-khau@mysql:3306/hub
# Địa chỉ công khai của dashboard (chỉ Origin này được gửi lệnh ghi)
HUB_ORIGIN=https://admin.baodom.xyz
# Chạy HTTPS thật thì để true (cookie __Host- Secure); thử local qua http thì false
COOKIE_SECURE=true
# Khóa master (32 byte base64) tự sinh vào file này nếu chưa có; mã thiết lập một lần ghi vào file thứ hai
HUB_MASTER_KEY_FILE=/run/hub/master-key
HUB_SETUP_TOKEN_FILE=/run/hub/setup-token
PORT=3200
